		local NavPanel = utility:RenderObject("Frame", { BackgroundColor3 = BG_CONTAINER, Parent = MainFrame, Position = UDim2.new(0, 12, 0, 55), Size = UDim2.new(0, 75, 1, -65) })
		utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 12), Parent = NavPanel })
		utility:RenderObject("UIStroke", { Color = BORDER_COLOR, Thickness = 1, Parent = NavPanel })
		local NavList = utility:RenderObject("UIListLayout", { Padding = UDim.new(0, 10), Parent = NavPanel, HorizontalAlignment = "Center", VerticalAlignment = "Top" })
		utility:RenderObject("UIPadding", { Parent = NavPanel, PaddingTop = UDim.new(0, 12) })
		
		local ContentFolder = utility:RenderObject("Folder", { Parent = MainFrame })
		makeSmoothDrag(MainFrame, 0.12)

		function Window:SetPage(Page)
			for _, page in pairs(Window.Pages) do if page.Open and page ~= Page then page:Set(false) end end
		end
		
		function Window:Fade(state)
			MainFrame.Visible = state
		end
		
		function Window:Unload()
			playSound(SOUNDS.UNLOAD, 0.5)
			saveConfig()
			task.wait(0.2)
			for _, conn in pairs(library.Connections) do pcall(function() conn:Disconnect() end) end
			ScreenGui:Destroy()
			notifGui:Destroy()
		end
		
		Window["TabsHolder"] = NavPanel
		Window["PagesHolder"] = ContentFolder
		
		utility:CreateConnection(uis.InputBegan, function(Input)
			if Input.KeyCode == Window.Key then
				Window.Enabled = not Window.Enabled
				Window:Fade(Window.Enabled)
			end
		end)
	end
	return setmetatable(Window, library)
end

-- [[ // Page Constructor // ]] 
function library:CreatePage(Properties)
	Properties = Properties or {}
	local Page = { Image = Properties.Image or "rbxassetid://6023426915", Open = false, Window = self }
	do
		local TabBtn = utility:RenderObject("Frame", { BackgroundColor3 = BG_ELEMENT, Parent = Page.Window["TabsHolder"], Size = UDim2.new(0, 50, 0, 50) })
		utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 10), Parent = TabBtn })
		utility:RenderObject("UIStroke", { Color = BORDER_COLOR, Thickness = 1, Parent = TabBtn })
		
		createGlow(TabBtn, ACCENT_GLOW, 0.2, 1.5)
		
		local TabIcon = utility:RenderObject("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Parent = TabBtn, Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 24, 0, 24), Image = Page.Image, ImageColor3 = TEXT_MUTED })
		local HitArea = utility:RenderObject("TextButton", { BackgroundTransparency = 1, Parent = TabBtn, Size = UDim2.new(1, 0, 1, 0), Text = "" })
		
		utility:CreateConnection(HitArea.MouseEnter, function()
			tws:Create(TabBtn, TweenInfo.new(0.2), { BackgroundColor3 = BG_HOVER }):Play()
		end)
		utility:CreateConnection(HitArea.MouseLeave, function()
			if not Page.Open then
				tws:Create(TabBtn, TweenInfo.new(0.2), { BackgroundColor3 = BG_ELEMENT }):Play()
			end
		end)
		
		local PageFrame = utility:RenderObject("Frame", { BackgroundTransparency = 1, Parent = Page.Window["PagesHolder"], Position = UDim2.new(0, 100, 0, 55), Size = UDim2.new(1, -112, 1, -65), Visible = false })
		local LeftColumn = utility:RenderObject("Frame", { BackgroundTransparency = 1, Parent = PageFrame, Size = UDim2.new(0.5, -6, 1, 0) })
		local RightColumn = utility:RenderObject("Frame", { BackgroundTransparency = 1, Parent = PageFrame, Position = UDim2.new(0.5, 6, 0, 0), Size = UDim2.new(0.5, -6, 1, 0) })
		utility:RenderObject("UIListLayout", { Padding = UDim.new(0, 10), Parent = LeftColumn })
		utility:RenderObject("UIListLayout", { Padding = UDim.new(0, 10), Parent = RightColumn })
		Page["Page"] = PageFrame
		Page["Left"] = LeftColumn
		Page["Right"] = RightColumn

		function Page:Set(state)
			Page.Open = state
			PageFrame.Visible = state
			tws:Create(TabBtn, TweenInfo.new(0.3, Enum.EasingStyle.Quart), { BackgroundColor3 = state and ACCENT_COLOR or BG_ELEMENT }):Play()
			tws:Create(TabIcon, TweenInfo.new(0.3), { ImageColor3 = state and TEXT_BRIGHT or TEXT_MUTED }):Play()
			if state then Page.Window:SetPage(Page) end
		end

		utility:CreateConnection(HitArea.MouseButton1Click, function() 
			playSound(SOUNDS.CLICK, 0.2)
			if not Page.Open then Page:Set(true) end
		end)
	end
	if #Page.Window.Pages == 0 then Page:Set(true) end
	Page.Window.Pages[#Page.Window.Pages + 1] = Page
	return setmetatable(Page, pages)
end

