-- [[ // Utility Functions // ]] 
function utility:RenderObject(RenderType, RenderProperties)
	local Render = Instance.new(RenderType)
	if RenderProperties and typeof(RenderProperties) == "table" then
		for Property, Value in pairs(RenderProperties) do
			Render[Property] = Value
		end
	end
	library.Renders[#library.Renders + 1] = Render
	return Render
end

function utility:CreateConnection(ConnectionType, ConnectionCallback)
	local Connection = ConnectionType:Connect(ConnectionCallback)
	library.Connections[#library.Connections + 1] = Connection
	return Connection
end

-- [[ // Smooth Dragging // ]] 
local function makeSmoothDrag(frame, dragSpeed)
	dragSpeed = dragSpeed or 0.15
	local dragging = false
	local dragInput, startPos, dragStart
	utility:CreateConnection(frame.InputBegan, function(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			utility:CreateConnection(input.Changed, function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	utility:CreateConnection(frame.InputChanged, function(input)
		if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			dragInput = input
		end
	end)
	utility:CreateConnection(RunService.RenderStepped, function()
		if dragging and dragInput then
			local delta = dragInput.Position - dragStart
			local targetPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			frame.Position = frame.Position:Lerp(targetPos, dragSpeed)
		end
	end)
end

-- [[ // Glow Effect // ]] 
local function createGlow(parent, color, transparency, size)
	color = color or ACCENT_GLOW
	transparency = transparency or 0.5
	size = size or 1.5
	
	local glow = Instance.new("ImageLabel")
	glow.BackgroundTransparency = 1
	glow.Image = "rbxassetid://2151741365"
	glow.ImageColor3 = color
	glow.ImageTransparency = transparency
	glow.Size = UDim2.new(size, 0, size, 0)
	glow.Position = UDim2.new(0.5, 0, 0.5, 0)
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Parent = parent
	glow.ScaleType = Enum.ScaleType.Fit
	return glow
}

