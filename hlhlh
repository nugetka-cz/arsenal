-- [[ // Color Picker // ]] 
local function createColorPicker(callback, currentColor)
	local colorGui = utility:RenderObject("ScreenGui", { DisplayOrder = 99999, Enabled = true, IgnoreGuiInset = true, Parent = cre, ResetOnSpawn = false })
	local mainFrame = utility:RenderObject("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = BG_CONTAINER, Parent = colorGui, Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 300, 0, 280) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 12), Parent = mainFrame })
	utility:RenderObject("UIStroke", { Color = BORDER_COLOR, Thickness = 1.5, Parent = mainFrame })
	
	local title = utility:RenderObject("TextLabel", { BackgroundTransparency = 1, Parent = mainFrame, Position = UDim2.new(0, 0, 0, 10), Size = UDim2.new(1, 0, 0, 30), Font = "GothamBold", Text = "Color Picker", TextColor3 = TEXT_BRIGHT, TextSize = 16 })
	
	local colorDisplay = utility:RenderObject("Frame", { Parent = mainFrame, Position = UDim2.new(0.5, -75, 0, 50), Size = UDim2.new(0, 150, 0, 60) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 8), Parent = colorDisplay })
	utility:RenderObject("UIStroke", { Color = BORDER_COLOR, Thickness = 1, Parent = colorDisplay })
	
	local currentR, currentG, currentB = currentColor[1] or 255, currentColor[2] or 255, currentColor[3] or 255
	
	local function updateDisplay()
		colorDisplay.BackgroundColor3 = Color3.fromRGB(currentR, currentG, currentB)
	end
	updateDisplay()
	
	local function createSlider(label, yPos, getVal, setVal, color)
		local lbl = utility:RenderObject("TextLabel", { BackgroundTransparency = 1, Parent = mainFrame, Position = UDim2.new(0, 20, 0, yPos), Size = UDim2.new(0, 30, 0, 20), Font = "GothamBold", Text = label, TextColor3 = color, TextSize = 14, TextXAlignment = "Left" })
		local track = utility:RenderObject("Frame", { BackgroundColor3 = Color3.fromRGB(200, 210, 220), Parent = mainFrame, Position = UDim2.new(0, 55, 0, yPos + 4), Size = UDim2.new(0, 180, 0, 12) })
		utility:RenderObject("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })
		local bar = utility:RenderObject("Frame", { BackgroundColor3 = color, Parent = track, Size = UDim2.new(getVal() / 255, 0, 1, 0) })
		utility:RenderObject("UICorner", { CornerRadius = UDim.new(1, 0), Parent = bar })
		
		local valLabel = utility:RenderObject("TextLabel", { BackgroundTransparency = 1, Parent = mainFrame, Position = UDim2.new(0, 240, 0, yPos), Size = UDim2.new(0, 40, 0, 20), Font = "GothamBold", Text = tostring(getVal()), TextColor3 = color, TextSize = 12 })
		
		local btn = utility:RenderObject("TextButton", { BackgroundTransparency = 1, Parent = track, Size = UDim2.new(1, 0, 1, 0), Text = "" })
		
		local function updateFromInput(input)
			local percentage = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			local val = math.floor(percentage * 255)
			setVal(val)
			bar.Size = UDim2.new(val / 255, 0, 1, 0)
			valLabel.Text = tostring(val)
			updateDisplay()
			callback(Color3.fromRGB(currentR, currentG, currentB))
		end
		
		local holding = false
		utility:CreateConnection(btn.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				holding = true
				updateFromInput(input)
			end
		end)
		utility:CreateConnection(uis.InputChanged, function(input)
			if holding and input.UserInputType == Enum.UserInputType.MouseMovement then
				updateFromInput(input)
			end
		end)
		utility:CreateConnection(uis.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then holding = false end
		end)
	end
	
	createSlider("R", 125, function() return currentR end, function(v) currentR = v end, Color3.fromRGB(255, 50, 50))
	createSlider("G", 165, function() return currentG end, function(v) currentG = v end, Color3.fromRGB(50, 255, 50))
	createSlider("B", 205, function() return currentB end, function(v) currentB = v end, Color3.fromRGB(50, 50, 255))
	
	local confirmBtn = utility:RenderObject("TextButton", { BackgroundColor3 = ACCENT_COLOR, Parent = mainFrame, Position = UDim2.new(0.5, -60, 0, 245), Size = UDim2.new(0, 120, 0, 25), Font = "GothamBold", Text = "Apply", TextColor3 = Color3.fromRGB(255, 255, 255), TextSize = 14, AutoButtonColor = false })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 6), Parent = confirmBtn })
	
	utility:CreateConnection(confirmBtn.MouseButton1Click, function()
		playSound(SOUNDS.CLICK, 0.3)
		callback(Color3.fromRGB(currentR, currentG, currentB))
		colorGui:Destroy()
	end)
	
	makeSmoothDrag(mainFrame, 0.12)
	return colorGui
end

