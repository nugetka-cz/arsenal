function sections:CreateToggle(Properties)
	Properties = Properties or {}
	local Content = { Name = Properties.Name or "Toggle", State = Properties.State or false, Callback = Properties.Callback or function() end, Section = self }
	local Row = utility:RenderObject("Frame", { BackgroundColor3 = BG_ELEMENT, Parent = Content.Section.Holder, Size = UDim2.new(1, 0, 0, 30) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 8), Parent = Row })
	
	local Switch = utility:RenderObject("Frame", { BackgroundColor3 = SWITCH_OFF, Parent = Row, Position = UDim2.new(1, -38, 0.5, -8), Size = UDim2.new(0, 28, 0, 16) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Switch })
	local Knob = utility:RenderObject("Frame", { BackgroundColor3 = Color3.fromRGB(255, 255, 255), Parent = Switch, Position = UDim2.new(0, 2, 0.5, -6), Size = UDim2.new(0, 12, 0, 12) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Knob })
	local Label = utility:RenderObject("TextLabel", { BackgroundTransparency = 1, Parent = Row, Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -60, 1, 0), Font = "Gotham", Text = Content.Name, TextColor3 = TEXT_BRIGHT, TextSize = 14, TextXAlignment = "Left" })
	local Btn = utility:RenderObject("TextButton", { BackgroundTransparency = 1, Parent = Row, Size = UDim2.new(1, 0, 1, 0), Text = "" })
	
	Content["Row"] = Row

	function Content:Set(state)
		Content.State = state
		tws:Create(Switch, TweenInfo.new(0.25, Enum.EasingStyle.Quart), { BackgroundColor3 = state and SWITCH_ON or SWITCH_OFF }):Play()
		tws:Create(Knob, TweenInfo.new(0.25, Enum.EasingStyle.Quart), { Position = state and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6) }):Play()
		if state then
			playSound(SOUNDS.TOGGLE_ON, 0.3)
		else
			playSound(SOUNDS.TOGGLE_OFF, 0.3)
		end
		Content.Callback(state)
	end

	utility:CreateConnection(Btn.MouseButton1Click, function() 
		playSound(SOUNDS.CLICK, 0.15)
		Content:Set(not Content.State) 
	end)
	
	utility:CreateConnection(Btn.MouseEnter, function()
		tws:Create(Row, TweenInfo.new(0.15), { BackgroundColor3 = BG_HOVER }):Play()
	end)
	utility:CreateConnection(Btn.MouseLeave, function()
		tws:Create(Row, TweenInfo.new(0.15), { BackgroundColor3 = BG_ELEMENT }):Play()
	end)
	
	Content:Set(Content.State)
	return Content
end

-- [[ // Slider Component // ]] 
function sections:CreateSlider(Properties)
	Properties = Properties or {}
	local Slider = { Name = Properties.Name or "Slider", Min = Properties.Min or 0, Max = Properties.Max or 100, State = Properties.State or 50, Callback = Properties.Callback or function() end, Section = self }
	local Container = utility:RenderObject("Frame", { BackgroundColor3 = BG_ELEMENT, Parent = Slider.Section.Holder, Size = UDim2.new(1, 0, 0, 40) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 8), Parent = Container })
	
	local Label = utility:RenderObject("TextLabel", { BackgroundTransparency = 1, Parent = Container, Position = UDim2.new(0, 12, 0, 2), Size = UDim2.new(1, -24, 0, 18), Font = "Gotham", Text = Slider.Name .. ": " .. Slider.State, TextColor3 = TEXT_BRIGHT, TextSize = 14, TextXAlignment = "Left" })
	local Track = utility:RenderObject("Frame", { BackgroundColor3 = Color3.fromRGB(180, 200, 220), Parent = Container, Position = UDim2.new(0, 12, 0, 26), Size = UDim2.new(1, -24, 0, 6) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Track })
	local Bar = utility:RenderObject("Frame", { BackgroundColor3 = ACCENT_COLOR, Parent = Track, Size = UDim2.new(0, 0, 1, 0) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(1, 0), Parent = Bar })
	local Btn = utility:RenderObject("TextButton", { BackgroundTransparency = 1, Parent = Track, Size = UDim2.new(1, 0, 1, 0), Text = "" })

	function Slider:UpdateValue(val)
		local percentage = math.clamp((val - Slider.Min) / (Slider.Max - Slider.Min), 0, 1)
		Bar.Size = UDim2.new(percentage, 0, 1, 0)
		Label.Text = Slider.Name .. ": " .. val
		Slider.State = val
		Slider.Callback(val)
	end

	local function updateFromInput(input)
		local percentage = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
		local val = math.floor(Slider.Min + (Slider.Max - Slider.Min) * percentage)
		Slider:UpdateValue(val)
	end

	local holding = false
	utility:CreateConnection(Btn.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then 
			holding = true
			updateFromInput(input) 
		end
	end)
	utility:CreateConnection(uis.InputChanged, function(input)
		if holding and input.UserInputType == Enum.UserInputType.MouseMovement then updateFromInput(input) end
	end)
	utility:CreateConnection(uis.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then holding = false end
	end)

	Slider:UpdateValue(Slider.State)
	Slider["Frame"] = Container
	return Slider
end

-- [[ // Dropdown Component // ]] 
function sections:CreateDropdown(Properties)
	Properties = Properties or {}
	local Dropdown = { Name = Properties.Name or "Dropdown", Options = Properties.Options or {}, State = Properties.State or 1, Callback = Properties.Callback or function() end, Section = self }
	local Container = utility:RenderObject("Frame", { BackgroundColor3 = BG_ELEMENT, Parent = Dropdown.Section.Holder, Size = UDim2.new(1, 0, 0, 40) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 8), Parent = Container })
	
	local Label = utility:RenderObject("TextLabel", { BackgroundTransparency = 1, Parent = Container, Position = UDim2.new(0, 12, 0, 2), Size = UDim2.new(1, -24, 0, 18), Font = "Gotham", Text = Dropdown.Name .. ": " .. Dropdown.Options[Dropdown.State], TextColor3 = TEXT_BRIGHT, TextSize = 14, TextXAlignment = "Left" })
	local Btn = utility:RenderObject("TextButton", { BackgroundColor3 = Color3.fromRGB(180, 200, 220), Parent = Container, Position = UDim2.new(0, 12, 0, 22), Size = UDim2.new(1, -24, 0, 14), Font = "GothamBold", Text = "▼", TextColor3 = TEXT_BRIGHT, TextSize = 12, AutoButtonColor = false })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Btn })

	local isOpen = false
	local DropdownFrame = utility:RenderObject("Frame", { BackgroundColor3 = BG_CONTAINER, Parent = Container, Position = UDim2.new(0, 12, 0, 22), Size = UDim2.new(1, -24, 0, 0), Visible = false })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 6), Parent = DropdownFrame })
	utility:RenderObject("UIStroke", { Color = BORDER_COLOR, Thickness = 1, Parent = DropdownFrame })
	local DropdownList = utility:RenderObject("UIListLayout", { Padding = UDim.new(0, 2), Parent = DropdownFrame })

	function Dropdown:Set(index)
		Dropdown.State = index
		Label.Text = Dropdown.Name .. ": " .. Dropdown.Options[index]
		Dropdown.Callback(index)
	end

	for i, option in ipairs(Dropdown.Options) do
		local optBtn = utility:RenderObject("TextButton", { BackgroundColor3 = BG_ELEMENT, Parent = DropdownFrame, Size = UDim2.new(1, 0, 0, 24), Font = "Gotham", Text = option, TextColor3 = TEXT_BRIGHT, TextSize = 13, AutoButtonColor = false })
		utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 4), Parent = optBtn })
		
		utility:CreateConnection(optBtn.MouseEnter, function()
			tws:Create(optBtn, TweenInfo.new(0.15), { BackgroundColor3 = BG_HOVER }):Play()
		end)
		utility:CreateConnection(optBtn.MouseLeave, function()
			tws:Create(optBtn, TweenInfo.new(0.15), { BackgroundColor3 = BG_ELEMENT }):Play()
		end)
		
		utility:CreateConnection(optBtn.MouseButton1Click, function()
			playSound(SOUNDS.CLICK, 0.15)
			Dropdown:Set(i)
			isOpen = false
			DropdownFrame.Visible = false
			DropdownFrame.Size = UDim2.new(1, -24, 0, 0)
			Btn.Text = "▼"
		end)
	end

	utility:CreateConnection(Btn.MouseButton1Click, function()
		playSound(SOUNDS.CLICK, 0.15)
		isOpen = not isOpen
		DropdownFrame.Visible = isOpen
		if isOpen then
			local count = #Dropdown.Options
			DropdownFrame.Size = UDim2.new(1, -24, 0, count * 26 + 4)
			Btn.Text = "▲"
		else
			DropdownFrame.Size = UDim2.new(1, -24, 0, 0)
			Btn.Text = "▼"
		end
	end)

	Dropdown:Set(Dropdown.State)
	return Dropdown
end

-- [[ // Label Component // ]] 
function sections:CreateLabel(Properties)
	Properties = Properties or {}
	local Label = { Name = Properties.Name or "Label", Section = self }
	local Row = utility:RenderObject("Frame", { BackgroundColor3 = BG_ELEMENT, Parent = Label.Section.Holder, Size = UDim2.new(1, 0, 0, 30) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 8), Parent = Row })
	
	local Text = utility:RenderObject("TextLabel", { BackgroundTransparency = 1, Parent = Row, Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 1, 0), Font = "Gotham", Text = Label.Name, TextColor3 = TEXT_MUTED, TextSize = 13, TextXAlignment = "Left" })
	
	function Label:Set(newText)
		Text.Text = newText
	end
	
	return Label
end

-- [[ // Button Component // ]] 
function sections:CreateButton(Properties)
	Properties = Properties or {}
	local Button = { Name = Properties.Name or "Button", Callback = Properties.Callback or function() end, Section = self }
	local Row = utility:RenderObject("Frame", { BackgroundColor3 = BG_ELEMENT, Parent = Button.Section.Holder, Size = UDim2.new(1, 0, 0, 30) })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 8), Parent = Row })
	
	local Btn = utility:RenderObject("TextButton", { BackgroundColor3 = Color3.fromRGB(180, 200, 220), Parent = Row, Position = UDim2.new(0.5, -60, 0, 4), Size = UDim2.new(0, 120, 0, 22), Font = "GothamBold", Text = Button.Name, TextColor3 = TEXT_BRIGHT, TextSize = 13, AutoButtonColor = false })
	utility:RenderObject("UICorner", { CornerRadius = UDim.new(0, 6), Parent = Btn })
	
	utility:CreateConnection(Btn.MouseEnter, function()
		tws:Create(Btn, TweenInfo.new(0.15), { BackgroundColor3 = ACCENT_COLOR }):Play()
	end)
	utility:CreateConnection(Btn.MouseLeave, function()
		tws:Create(Btn, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(180, 200, 220) }):Play()
	end)
	
	utility:CreateConnection(Btn.MouseButton1Click, function()
		playSound(SOUNDS.CLICK, 0.2)
		Button.Callback()
	end)
	
	return Button
end

-- [[ // Export // ]] 
return library
